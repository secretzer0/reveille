# Route a tenant's hostname to its socket. That is the whole job.
#
# NO TLS HERE, ON PURPOSE. Cloudflare terminates it at the edge and cloudflared carries the
# request to this box inside its own outbound tunnel, so nothing crosses the internet in
# clear and Caddy never needs a certificate. That deletes the Let's Encrypt problem
# outright: per-subdomain certs would hit LE's ~50/week cap and wedge at roughly customer
# 50 -- with the failure landing on new signups. Cloudflare's Universal SSL already covers
# *.mythos.org (one label deep, which is exactly what a tenant is).
#
# Bound to loopback: this listener is reachable only through the tunnel, so pve0 exposes no
# port to the LAN or the internet.
{
	auto_https off
	admin off
}

http://:8080 {
	# tenant.mythos.org -> /srv/reveille/<tenant>/broker.sock
	# The subdomain label IS the routing key, so provisioning touches no config here: a new
	# tenant is a directory, and this block already knows how to find it.
	@tenant header_regexp host Host ^([a-z0-9][a-z0-9-]{1,30}[a-z0-9])\.mythos\.org$
	handle @tenant {
		reverse_proxy unix//srv/reveille/{re.host.1}/broker.sock {
			# wake and feed are WebSockets held open for hours. A proxy that reaps them turns
			# "my agent went deaf" into a ticket nobody can reproduce.
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Host {host}
		}
	}

	# The apex is the front door, not a tenant. Served separately (docs/landing); until that
	# exists, say so rather than 502-ing into a tenant lookup for "mythos.org".
	handle {
		respond "Reveille: no tenant in that hostname." 404
	}

	handle_errors {
		# A stopped or missing tenant must not read as a broken bus.
		respond "no such tenant, or its broker is down" 502
	}
}
