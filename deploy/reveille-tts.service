# /etc/systemd/system/reveille-tts.service -- the synthesizer as a HOST service
# (S3, ruled 11961/11965: "write the unit, the operator installs it").
#
# WHY THIS EXISTS AT ALL. The TTS already runs perfectly well as compose's
# `voices` profile. What it does NOT do there is run without something holding
# the docker socket to start it -- and S2 ruled that the launcher's read verbs
# never gain exec/run/compose, so the agent that keeps this fleet alive has no
# way to bring the synthesizer back and must not be given one. A systemd unit
# moves that authority to the machine's own init, where it belongs: the operator
# installs it once, and afterwards the service survives reboots, restarts on
# failure, and is controlled with `systemctl` by a human at that host.
#
# WHERE IT LISTENS IS A DEPLOYMENT FACT, NOT A CONSTANT (architect, blocking on
# the first draft of this file). That draft hardcoded 127.0.0.1:8004, which is
# right for a broker on the same host and WRONG for this fleet: the synthesizer
# runs on its own host and the VM broker reaches it across the LAN. Installed as
# first written, this unit would have silenced the fleet's voice the moment it
# replaced what ran there. So the bind address and published port come from
# Environment=, the defaults are the same-host case, and THIS deployment
# overrides them.
#
# THE HOST MOVED, AND THAT IS THE POINT OF THE OVERRIDE. Until 2026-08-19 the
# synthesizer ran on the operator's laptop at 192.168.90.136:18004; it now runs
# on titan.vyzon.ai (192.168.89.104:18004). Nothing in this file changed to
# follow it except the worked example below -- which is what "deployment fact,
# not a constant" was supposed to buy.
#
# A LAN IP, NEVER 0.0.0.0. The synthesizer is unauthenticated by design (DES-009
# section 3: one caller, no public port), so it is bound to exactly the address
# the broker was told to call and no other. `REVEILLE_LAN_PLAINTEXT` naming
# 192.168.89.104 is the operator's ruled acceptance of that hop in the clear on
# their own LAN -- it is not a licence to answer on every interface the host has.
#
# INSTALL (operator, once):
#   sudo cp deploy/reveille-tts.service /etc/systemd/system/
#   sudo systemctl edit reveille-tts        # add the [Service] block below
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now reveille-tts
#   systemctl status reveille-tts           # and `journalctl -u reveille-tts -f`
#
# FOR THIS DEPLOYMENT (titan.vyzon.ai, 192.168.89.104 -- measured on the host,
# 2026-08-19), the override is:
#   [Service]
#   Environment=TTS_BIND=192.168.89.104
#   Environment=TTS_PUBLISH_PORT=18004
#   Environment=TTS_REFERENCE=/home/vyzon/tts-measure/reference_audio
#   Environment=TTS_CACHE=/home/vyzon/tts-measure/hf_cache
#   Environment=TTS_BATCH_SIZE=1
#   User=vyzon
# matching the broker's REVEILLE_TTS_URL exactly. Nothing about the broker
# changes; that is the point of overriding rather than editing.
#
# NOTE WHAT IS *NOT* IN THAT LIST: no TTS_EXTRA. The laptop deployment bind-
# mounted a working tree over /app so the server ran code from disk; titan runs
# the image's own copy, built from the pinned SHA. Same-name-different-software
# is the hardest failure to see, and the fix was to stop doing it, not to
# document it better.
#
# The watchdog that keeps this unit honest is a separate pair of files --
# deploy/reveille-tts-watchdog.{sh,service,timer} (S3.1, ruled 12084). It probes
# the MODEL, not the port, because a container serving on CPU after the card
# vanished answers every request and is still broken. On titan it needs
#   Environment=WATCHDOG_URL=http://192.168.89.104:18004
# in ITS override, since this unit publishes on the LAN address, not loopback.
#
# A same-host broker needs no override at all: the defaults below are
# 127.0.0.1:8004 with named volumes, and REVEILLE_TTS_URL=http://127.0.0.1:8004
# in $SERVER_DATA/reveille.env. Unset that variable and the broker simply runs no
# voice worker -- voices off beats a transcript in flight, unchanged.
#
# UNINSTALL: `sudo systemctl disable --now reveille-tts`. The named volumes are
# NOT removed with it -- the model cache is about a gigabyte and re-downloading
# it is a ten-minute first start that the operator would meet on their next
# deploy rather than their first.

[Unit]
Description=reveille TTS (Chatterbox-TTS-Server, pinned by docker/tts.upstream)
Documentation=https://github.com/secretzer0/reveille/blob/main/docs/DES-009-agent-voices.md
# The daemon, not the network: this starts a container, and docker is the
# dependency that actually has to be up. network-online alone would let it race
# dockerd on a cold boot and fail into the restart ladder for no reason.
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=exec
# The tag the deploy builds. Bumping it is the same act as bumping any other
# pinned image (ruling 10877): move the pin, rebuild, restart the unit -- an
# image bump without a moved pin is red in CI, and a moved pin without a
# restart here is a unit still running the old one.
Environment=TTS_IMAGE=reveille-tts:0.2.4
Environment=TTS_NAME=reveille-tts
# Where it LISTENS. Defaults are the same-host case; a deployment whose broker
# is elsewhere overrides both to the address it told the broker to call.
Environment=TTS_BIND=127.0.0.1
Environment=TTS_PUBLISH_PORT=8004
# The mount sources. Named volumes by default; a deployment that keeps them on
# disk names the paths instead.
Environment=TTS_REFERENCE=reveille_tts-reference
Environment=TTS_CACHE=reveille_tts-cache
# ANYTHING ELSE THIS HOST NEEDS, and the reason it is a variable: this
# deployment bind-mounts a working tree over /app, so the SERVER'S OWN CODE
# comes from disk rather than from the image. A unit that quietly ran the
# image's copy instead would be running different software under the same name
# -- the hardest kind of difference to see, and the one nobody thinks to check
# when the voice sounds wrong. Written UNBRACED on purpose: systemd splits
# $VAR into words and passes ${VAR} as ONE argument, so a braced form here
# would hand docker a single unparsable blob.
Environment=TTS_EXTRA=
# Upstream PR #161 on our fork batches a request's chunks through the turbo
# decoder. 4 is what an 8 GB card holds with real chunks (7.7 GB peak; 8 OOMs).
# A 12 GB card can take 8 once that is MEASURED on it -- not before.
#
# AND IT MUST BE MEASURED DOWNWARD TOO. titan's 4 GB card cannot hold the batched
# path at 4: every multi-chunk request OOMed inside synthesize_batch and fell back
# to sequential, which SUCCEEDS -- correct audio, an OOM per request, and nothing
# in the response to say so. At 1 there is no fallback and no OOM. A default
# tuned for the biggest card silently taxes every smaller one.
Environment=TTS_BATCH_SIZE=4

# Idempotent start: a container left behind by a kill -9, a host that lost power
# mid-run, or an operator who ran `docker run` by hand once must not turn every
# later start into "name already in use". Failure here is ignored on purpose --
# there is usually nothing to remove.
ExecStartPre=-/usr/bin/docker rm -f ${TTS_NAME}
# ONE ADDRESS, NAMED. ${TTS_BIND} is an address, never a wildcard: the
# synthesizer answers where the broker was told to call it and nowhere else.
ExecStart=/usr/bin/docker run --rm --name ${TTS_NAME} \
    -p ${TTS_BIND}:${TTS_PUBLISH_PORT}:8004 \
    -e TTS_BATCH_SIZE=${TTS_BATCH_SIZE} \
    -v ${TTS_REFERENCE}:/app/reference_audio \
    -v ${TTS_CACHE}:/app/hf_cache \
    --gpus all $TTS_EXTRA \
    ${TTS_IMAGE}
ExecStop=/usr/bin/docker stop -t 30 ${TTS_NAME}

Restart=on-failure
RestartSec=10
# THE MODEL LOADS AT START, and downloads on a fresh cache: minutes, not
# seconds. A short start timeout would kill it mid-download and then kill the
# retry too, forever, while the log said only "timed out" (DES-009's own
# start_period is 15m for the same reason).
TimeoutStartSec=20min
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
