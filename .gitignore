__pycache__/
*.pyc
.venv/
reveille.log
reveille.pid
.envrc
.ruff_cache/
.mypy_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# playwright MCP scratch output (snapshots, console logs). The bare
# filename form too: browser_snapshot(filename=...) writes to the repo
# ROOT, not into .playwright-mcp/, and one of those rode a PR on
# 2026-08-19 before review caught it.
.playwright-mcp/
*-page.yml
page-*.yml

# migration snapshots are operational artifacts, never source
*.bak
.ropeproject/

# NEVER: a live broker database dropped into the tree for inspection. It holds
# every room history, password hashes and token hashes, and `git add -A` will
# take it without asking. It happened once.
broker.db
*.db
shots/
.mcp.json
CLAUDE.local.md
.claude/

# NEVER: voice-bank clips. The bank is DATA the operator supplies -- film/TV-
# sampled voices in the live one -- and committing a clip to a public repo is
# redistribution (ruled 14925: clips never enter git, by construction and by
# gate). The one audio file the page ships is allowlisted below; anything
# else with an audio extension is refused here and asserted absent by
# tests/test_no_audio_lands_in_git.py.
*.wav
*.mp3
*.flac
*.ogg
*.m4a
!src/reveille/ui/bus/earcon.wav
