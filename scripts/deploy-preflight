#!/usr/bin/env bash
# Deploy preflight (architect ruling, msg 8595): REFUSE rather than silently
# create. SERVER_DATA follows whoever invokes the deploy ($(HOME)/reveille by
# default), so the same `make up` that upgrades the broker under one account
# would, under another, recreate it on an EMPTY database -- every message, room,
# memory and user gone from view, the real file untouched on disk with nothing
# pointing at it. That is not a deploy step to be careful about; it is a defect,
# and it was caught by luck (an inspect before acting), which is not a control.
#
# The rule: if the target data root does not already hold the database, AND the
# container being replaced is currently serving one from somewhere else, stop
# and say so. A first boot (no database anywhere, nothing running) is legitimate
# and proceeds. Overriding is deliberate: point SERVER_DATA at the real root, or
# remove the old container first if a fresh database is genuinely intended.
set -u

data="${1:?usage: deploy-preflight <SERVER_DATA> [broker-container] [proxy-container] [proxy-site]}"
broker="${2:-reveille-server}"
proxy="${3:-reveille-proxy}"
site="${4:-}"

# THE FRONT DOOR FOLLOWS THE SAME RULE. PROXY_SITE defaults to ":80" and only a
# hostname turns on HTTPS, so a `make up` that forgets it recreates the proxy
# on plain HTTP and the public URL stops answering TLS -- which happened on the
# 0.2.97 deploy: nine minutes with every remote agent's bus unreachable, and
# nothing said why until someone read the caddy log. If the proxy being
# replaced serves a hostname and this deploy would demote it to a bare port,
# stop and name the command. A first boot, or a proxy already on a bare port,
# proceeds.
serving="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$proxy" 2>/dev/null \
           | sed -n 's/^PROXY_SITE=//p' || true)"
case "$serving" in
  ""|:*) ;;
  *)
    case "$site" in
      ""|:*)
        echo "REFUSING to deploy: the running $proxy serves $serving over HTTPS, but" >&2
        echo "this deploy would recreate it on '${site:-:80}' -- plain HTTP, no TLS," >&2
        echo "and the public URL stops answering." >&2
        echo "  intended upgrade:  make up PROXY_SITE=$serving" >&2
        echo "  intended demotion: docker rm -f $proxy, then re-run" >&2
        exit 1 ;;
    esac ;;
esac

current="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Source}}{{end}}{{end}}' \
           "$broker" 2>/dev/null || true)"

if [ ! -f "$data/broker.db" ] && [ -n "$current" ] && [ "$current" != "$data" ]; then
  echo "REFUSING to deploy: SERVER_DATA=$data holds no broker.db, but the running" >&2
  echo "$broker is serving one from: $current" >&2
  echo "Deploying now would bring the bus back EMPTY -- every message, room and" >&2
  echo "user invisible, with the real database orphaned on disk." >&2
  echo "  intended upgrade:      make up SERVER_DATA=$current" >&2
  echo "  intended fresh start:  docker rm -f $broker, then re-run" >&2
  exit 1
fi

mkdir -p "$data"

# THE IDENTITY BACKFILL REFUSES ON A NAME IT CANNOT ATTRIBUTE, and this is where
# the operator must meet that refusal -- BEFORE anything stops.
#
# The refusal itself is right: history whose names have no `agents` row cannot be
# attributed without inventing an owner, and inventing one is what DES-007 6.1
# forbids. But it lives inside migrate(), which runs at broker STARTUP -- so
# without this check the operator learns about it after `make up` has already
# taken down what was serving. Correct refusal, outage timing (architect, 8946).
#
# Here it is the same information one step earlier, with nothing down to deliver
# it. The seeder only INSERTS rows, so it runs against the live database with the
# OLD broker still up, and the deploy then proceeds with no gap at any point.
#
# Same rows through the same code as the migration and the seeder: it calls
# store.unresolved_agent_names, so the three cannot drift into a preflight that
# passes a database the migration will refuse.
if [ -f "$data/broker.db" ]; then
  repo="$(cd "$(dirname "$0")/.." && pwd)"
  if ! (cd "$repo" && uv run --quiet python - "$data/broker.db" <<'PY'
import sys
from reveille import store

conn = store.connect(sys.argv[1])
pending = store.unresolved_agent_names(conn)
if pending:
    print("REFUSING to deploy: this database has history the identity backfill "
          "cannot attribute.", file=sys.stderr)
    for e in pending:
        print(f"  {e['name']}: {e['messages']} messages, {e['memories']} memories, "
              f"{e['lessons']} lessons", file=sys.stderr)
    print("The migration runs at broker startup and REFUSES on these, so deploying "
          "now would stop what is serving and fail to bring it back.", file=sys.stderr)
    print("Assign them once, deliberately, with the broker still up:", file=sys.stderr)
    print(f"  uv run python scripts/seed_agent_identities.py {sys.argv[1]} "
          f"--assign <user>", file=sys.stderr)
    sys.exit(1)
PY
  ); then
    exit 1
  fi
fi
