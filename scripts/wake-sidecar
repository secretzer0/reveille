#!/usr/bin/env bash
# Persistent wake sidecar for ONE tmux pane. Launched detached (setsid -f) by scripts/agent
# from the real pane shell -- NOT Claude's Bash sandbox -- so it is not reaped with exit 144.
# It holds one wake connection (0 tokens; a socket client, not an LLM) and pokes the pane on
# every ring. It EXITS when the Claude process it serves exits, or when the pane goes away,
# so it never orphans into a loop that types into a bare shell. On boot it pokes once with
# the info()/usage() directive and the broker/client versions.
#
#   wake-sidecar <pane-id> <claude-pid> <wake-url> <role> <token> <server-ver> <client-ver> <wake-bin> [arg...]
set -u

pane="$1"; claude_pid="$2"; wake_url="$3"; role="$4"; token="$5"; server_v="$6"; client_v="$7"; shift 7
wake_bin=("$@")   # a path, or "uv run --project <repo> wake" split across args
COOLDOWN="${REVEILLE_COOLDOWN:-30}"   # min seconds between ring pokes to this pane
RING="Reveille ring -- inbox(), ack() everything. Reply only if it names you, blocks you, or asks you directly. Silence is a valid turn."

alive() { kill -0 "$claude_pid" 2>/dev/null \
          && tmux list-panes -aF '#{pane_id}' 2>/dev/null | grep -qx "$pane"; }

# Type text into the pane, then submit. The text and the Enter MUST be separate sends with a
# pause between: Claude's input treats a text+Enter burst as a paste, so the Enter lands as a
# newline instead of submitting. -l sends the text literally (no key-name interpretation).
poke() {
    tmux send-keys -t "$pane" -l -- "$1"
    sleep 0.4
    tmux send-keys -t "$pane" Enter
}

# Boot directive, once: tell the freshly-launched client exactly what to do. Delay so the
# Claude TUI is ready for keystrokes. Versions surface a stale client/broker.
( sleep 4
  mm=""
  [ "$server_v" != "$client_v" ] && [ "$server_v" != "unreachable" ] && mm=" (VERSION MISMATCH -- update)"
  alive && poke "Reveille boot v$server_v$mm -- run info() to confirm the bus, then usage() to refresh your CLAUDE.md ## Agent bus block"
) &

# Watchdog: the moment Claude exits (or the pane vanishes), kill our whole process group so
# the wake child -- which may be blocked on the socket -- dies with us. setsid put this
# sidecar in its own session/group, so `kill 0` cannot touch Claude or the pane's shell.
( while alive; do sleep 2; done; kill -TERM 0 2>/dev/null ) &

# Reconnect loop. Rings are DEBOUNCED so a burst can't storm the pane: poke on the first
# ring (instant wake), then swallow every ring for COOLDOWN seconds of quiet -- the agent's
# inbox() already pulls all pending mail, so extra rings are noise. If any were swallowed,
# poke once more (trailing edge) so a straggler that arrived after the agent finished is not
# lost. Net: a storm = one poke at the start + one at the end, >= COOLDOWN apart.
while alive; do
    "${wake_bin[@]}" --url "$wake_url" --name "$role" --token "$token" | {
        while IFS= read -r _; do          # blocks until a ring arrives
            poke "$RING"                    # leading edge: wake now
            got=1
            while [ "$got" = 1 ]; do
                got=0
                while IFS= read -r -t "$COOLDOWN" _; do got=1; done   # swallow until quiet
                [ "$got" = 1 ] && poke "$RING"                        # trailing: cover stragglers
            done
        done
    }
    sleep 2
done
