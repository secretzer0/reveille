#!/usr/bin/env python3
"""One-time identity merge (DES-011 section 7): re-point one agent's rows onto
another, then retire the emptied name.

MERGE, THEN RETIRE. NEVER PRUNE. prune() erases; the operator's condition for
collapsing the two architect identities was that everything survives on the
final name, so this tool only ever re-points and retires.

WHY A SCRIPT AND NOT A FEATURE: the general operation belongs with DES-011
section 6, once membership, receipts and routing key on the id underneath.
Tonight there is exactly one merge to perform and a script that does it in one
transaction, with a dry run anyone can read, is the smaller thing.

THE SITE LIST IS ENUMERATED, so a missed one is a diff rather than a
discovery. The site most easily missed is not a column at all: state notes
live in memories.scope as the STRING 'agent:<id>' (store._rescope_state_notes
is the precedent -- an earlier migration got that plane wrong and moved 47 of
50 notes to dead scopes).

Procedure, which is DES-010 section 7's discipline because it is the same
class of act -- a bulk rewrite of the live database:

    stop the broker
    back it up            (sqlite3 db 'VACUUM INTO ...' )
    identity-merge --db ... --from X --to Y --backup <file> --dry-run
    read the counts
    identity-merge ...    --apply
    start the broker, verify

A merge under a live writer is the same gamble as a migration under one.
"""
import argparse
import json
import os
import sqlite3
import sys
import time

# Every table carrying an agent id, re-pointed by a plain UPDATE. Enumerated,
# never discovered.
#
# `tokens` is DELIBERATELY ABSENT. A revoke DELETES its row (store.revoke_token),
# so every row in tokens is a LIVE credential -- re-pointing them would hand the
# survivor a second live credential and break one-identity-one-live-credential
# with the tool built to repair identity (devops rehearsal, msg 10959). Source
# credentials are SUPERSEDED instead, below.
ID_SITES = (
    ("messages", "sender_agent_id"),        # attribution of every message sent
    ("memories", "author_agent_id"),        # who authored a fact
    ("reads", "agent_id"),                  # receipts
    ("token_tombstones", "agent_id"),       # supersede signposts
    ("token_audit", "agent_id"),            # credential audit
)


def has_table(conn, name):
    """A rehearsal against an older backup is legitimate, so an absent table is
    reported rather than fatal -- but never silently skipped."""
    return bool(conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?",
        (name,)).fetchone())


def die(msg):
    print(f"identity-merge: {msg}", file=sys.stderr)
    raise SystemExit(1)


def live_agent(conn, name):
    """The one LIVE agents row for this name, or a refusal naming what it found.

    Never resolves through a preference (ORDER BY, newest, live-first): a
    resolution that guesses is how one agent's history gets handed to another
    by a migration, silently (msg 9000). Ambiguity is the operator's to settle.
    """
    rows = conn.execute(
        "SELECT id, owner_id, name, retired_ns FROM agents "
        "WHERE name=? AND retired_ns IS NULL", (name,)).fetchall()
    if len(rows) != 1:
        die(f"{name!r} resolves to {len(rows)} live agents; expected exactly 1")
    return rows[0]


def any_agent(conn, ref):
    """A source may be RETIRED, so sources resolve by ID as well as by name.

    The live census found FOUR architect identities, two of them retired and
    one of those holding 37 state notes -- the institutional memory worth
    recovering (msg 10952). A tool that only speaks live names cannot fold
    them, and a name that two retired rows share cannot be resolved at all.
    An id is exact; a name still has to be unambiguous and live.
    """
    row = conn.execute("SELECT id, owner_id, name, retired_ns FROM agents "
                       "WHERE id=?", (ref,)).fetchone()
    return row if row else live_agent(conn, ref)


def counts(conn, agent_id):
    """What would move, per site, before anything moves."""
    out = {}
    for table, col in ID_SITES:
        if not has_table(conn, table):
            out[f"{table}.{col}"] = "ABSENT"
            continue
        out[f"{table}.{col}"] = conn.execute(
            f"SELECT count(*) FROM {table} WHERE {col}=?", (agent_id,)).fetchone()[0]
    out["memories.scope(state)"] = conn.execute(
        "SELECT count(*) FROM memories WHERE scope=?", (f"agent:{agent_id}",)).fetchone()[0]
    out["members(rows)"] = conn.execute(
        "SELECT count(*) FROM members WHERE agent_id=?", (agent_id,)).fetchone()[0]
    out["tokens(live, to supersede)"] = conn.execute(
        "SELECT count(*) FROM tokens WHERE agent_id=?", (agent_id,)).fetchone()[0]
    return out


def merge(conn, src, dst, dst_rooms):
    """Re-point src onto dst inside the caller's transaction. Returns a report.

    dst_rooms is the survivor's room set, CARRIED ACROSS SOURCES and updated as
    rooms are gained: merge() runs once per source, and a room the first source
    handed over is one the second must already see as the survivor's.
    """
    moved = {}
    for table, col in ID_SITES:
        if not has_table(conn, table):
            moved[f"{table}.{col}"] = 0
            continue
        moved[f"{table}.{col}"] = conn.execute(
            f"UPDATE {table} SET {col}=? WHERE {col}=?", (dst["id"], src["id"])).rowcount

    # State notes hide in a STRING, not a column (DES-011 section 7).
    moved["memories.scope(state)"] = conn.execute(
        "UPDATE memories SET scope=? WHERE scope=?",
        (f"agent:{dst['id']}", f"agent:{src['id']}")).rowcount

    # THE MERGE IS A SUPERSESSION (devops rehearsal, msg 10959). A revoke
    # DELETES the row, so every tokens row is a LIVE credential: re-pointing
    # them would leave the survivor holding two, which is the invariant this
    # whole design rests on, broken by the tool that repairs identity. The
    # source's credentials are superseded exactly as the broker would --
    # memberships orphaned, room grants dropped, row deleted -- and each leaves
    # a TOMBSTONE, so the displaced body's next call gets the signpost rather
    # than a bare refusal. That is honest: it WAS superseded, by this merge.
    superseded = 0
    for tok in conn.execute("SELECT id, secret_hash FROM tokens WHERE agent_id=?",
                            (src["id"],)).fetchall():
        if has_table(conn, "token_tombstones"):
            conn.execute(
                "INSERT OR REPLACE INTO token_tombstones"
                "(secret_hash, agent_id, superseded_ns) VALUES(?,?,?)",
                (tok["secret_hash"], dst["id"], time.time_ns()))
        conn.execute("UPDATE members SET token_id=NULL WHERE token_id=?", (tok["id"],))
        conn.execute("DELETE FROM token_rooms WHERE token_id=?", (tok["id"],))
        conn.execute("DELETE FROM tokens WHERE id=?", (tok["id"],))
        superseded += 1
    moved["tokens.superseded"] = superseded

    # MEMBERSHIP IS KEYED BY ID, NEVER BY NAME. Two of the folding identities
    # share the SURVIVOR'S name, so a name-keyed pass reads the survivor's own
    # rows as the loser's and deletes them -- measured: the survivor came out
    # of a rehearsal in ZERO rooms, deaf the moment the broker restarted, with
    # every transport signal green. That is tonight's failure rebuilt by its
    # own repair tool, and the fix is to stop letting a NAME identify a body.
    dropped = relabelled = 0
    for r in conn.execute("SELECT room_id, name FROM members WHERE agent_id=?",
                          (src["id"],)).fetchall():
        if r["room_id"] in dst_rooms:
            # The ghost that keeps a dead name in presence.
            conn.execute("DELETE FROM members WHERE room_id=? AND name=?",
                         (r["room_id"], r["name"]))
            dropped += 1
        else:
            conn.execute(
                "UPDATE members SET name=?, agent_id=? WHERE room_id=? AND name=?",
                (dst["name"], dst["id"], r["room_id"], r["name"]))
            dst_rooms.add(r["room_id"])   # the next source must see it as ours
            relabelled += 1
    moved["members.dropped(ghost)"] = dropped
    moved["members.relabelled"] = relabelled

    # Rows predating agent ids cannot be attributed, so they are COUNTED rather
    # than guessed at -- a silent skip reads as "nothing there".
    moved["members.unattributed(left)"] = conn.execute(
        "SELECT count(*) FROM members WHERE agent_id IS NULL AND name=?",
        (src["name"],)).fetchone()[0]

    # RETIRE, never delete: the row is the record that this name existed and
    # what became of it, and retiring frees the label for reuse.
    conn.execute("UPDATE agents SET retired_ns=? WHERE id=?",
                 (time.time_ns(), src["id"]))
    return moved


def main():
    p = argparse.ArgumentParser(description="DES-011 one-time identity merge")
    p.add_argument("--db", required=True)
    p.add_argument("--from", dest="src", action="append", required=True,
                   metavar="NAME_OR_ID",
                   help="identity merged AWAY; repeatable. A RETIRED identity "
                        "must be named by id, because only live names resolve")
    p.add_argument("--to", dest="dst", required=True, help="surviving name")
    p.add_argument("--backup", help="path to the pre-merge backup (must exist)")
    p.add_argument("--apply", action="store_true",
                   help="without this, nothing is written")
    a = p.parse_args()

    conn = sqlite3.connect(a.db, isolation_level=None)
    conn.row_factory = sqlite3.Row
    dst = live_agent(conn, a.dst)
    sources = [any_agent(conn, s) for s in a.src]
    seen = set()
    for s in sources:
        if s["id"] == dst["id"]:
            die("--from and --to resolve to the same identity")
        if s["id"] in seen:
            die(f"{s['id']} named twice as a source")
        seen.add(s["id"])
        if s["owner_id"] != dst["owner_id"]:
            die(f"{s['name']} ({s['id']}) has a different owner than the "
                f"survivor; merging across owners is a different act and this "
                f"tool refuses it")

    print(f"  to {dst['name']} ({dst['id']})\n")
    for s in sources:
        state = "retired" if s["retired_ns"] else "live"
        print(f"from {s['name']} ({s['id']}, {state})")
        for k, v in counts(conn, s["id"]).items():
            print(f"  {v:6d}  {k}")
        print()

    if not a.apply:
        print("\ndry run -- nothing written. Re-run with --apply.")
        return

    # The backup is checked HERE rather than trusted, because this is the
    # point of no return and the remedy for getting it wrong is the backup.
    if not a.backup or not os.path.isfile(a.backup) or os.path.getsize(a.backup) == 0:
        die("--apply needs --backup naming an existing non-empty pre-merge "
            "backup (sqlite3 db \"VACUUM INTO 'file'\"). Refusing.")

    conn.execute("BEGIN IMMEDIATE")
    try:
        moved = {}
        dst_rooms = {r["room_id"] for r in conn.execute(
            "SELECT room_id FROM members WHERE agent_id=?", (dst["id"],))}
        for s in sources:
            for k, v in merge(conn, s, dst, dst_rooms).items():
                moved[k] = moved.get(k, 0) + v
        bad = conn.execute("PRAGMA foreign_key_check").fetchall()
        if bad:
            raise RuntimeError(f"merge left {len(bad)} FK violations")
        conn.execute("COMMIT")
    except Exception:
        conn.execute("ROLLBACK")
        raise

    for s in sources:
        left = counts(conn, s["id"])
        stranded = {k: v for k, v in left.items()
                    if isinstance(v, int) and v and not k.startswith("members")}
        if stranded:
            die(f"rows still point at {s['id']}: {stranded}")

    record = {"ts_ns": time.time_ns(), "to": dict(dst), "des": "DES-011 section 7",
              "from": [{"id": s["id"], "name": s["name"],
                        "was_retired": bool(s["retired_ns"])} for s in sources],
              "moved": moved}
    log = os.path.join(os.path.dirname(os.path.abspath(a.db)), "identity-merges.jsonl")
    with open(log, "a") as f:
        f.write(json.dumps(record) + "\n")

    print("\nmerged:")
    for k, v in moved.items():
        print(f"  {v:6d}  {k}")
    print(f"\nrecorded in {log}")
    survivor_rooms = [r["room_id"] for r in conn.execute(
        "SELECT room_id FROM members WHERE agent_id=?", (dst["id"],))]
    live_tokens = conn.execute("SELECT count(*) FROM tokens WHERE agent_id=?",
                               (dst["id"],)).fetchone()[0]
    print(f"survivor holds {len(survivor_rooms)} room(s) and {live_tokens} live "
          f"credential(s)")
    if not survivor_rooms:
        die("the survivor ended in ZERO rooms -- it would be deaf on restart")
    print(f"{len(sources)} identities retired; their ids and rows are intact "
          f"and now point at {dst['name']!r} ({dst['id']}).")


if __name__ == "__main__":
    main()
