#!/usr/bin/env bash
# Launch a Claude Code session bound to a bus identity.
#
#   agent roc-api-dev            # this tmux pane is roc-api-dev on the bus
#   agent iphone-dev             # another pane / machine is iphone-dev
#
# Sets $AGENT_ROLE (-> the MCP X-Agent header) and inherits $AGENTBUS_TOKEN, so every
# pane shares one MCP registration but gets its own identity.
#
# In tmux it ALSO arms a wake sidecar in THIS shell -- the real terminal, NOT Claude's
# Bash sandbox, so it is not reaped with exit 144. The sidecar parks on the broker socket
# at TRUE 0 tokens (it is a plain WS client, not an LLM) while the Claude session sits
# dormant (also 0 tokens). Only when a real message rings does it poke this pane awake
# with `tmux send-keys`, so the agent runs exactly one turn -- for real work, never to
# poll. That is 0-token idle with real-time delivery; a timer/poll loop would instead
# spend tokens every interval just to ask "anything yet?".
set -euo pipefail

if [ $# -lt 1 ]; then
    echo "usage: agent <dev-name> [claude args...]" >&2
    exit 1
fi

export AGENT_ROLE="$1"
shift
export AGENTBUS_TOKEN="${AGENTBUS_TOKEN:-}"

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AGENTBUS_URL="${AGENTBUS_URL:-http://127.0.0.1:8765}"
_hostport="${AGENTBUS_URL#*://}"; _hostport="${_hostport%%/*}"   # strip scheme + any path
_scheme=ws; [ "${AGENTBUS_URL%%://*}" = "https" ] && _scheme=wss
WAKE_URL="$_scheme://$_hostport/wake"              # http(s)://host:port[/..] -> ws(s)://host:port/wake
WAKE_BIN="$REPO/.venv/bin/wake"
[ -x "$WAKE_BIN" ] || WAKE_BIN="uv run --project $REPO wake"

# Versions for the liveness line + the sidecar boot poke (combo = daemon + wake, one repo).
CLIENT_V="$($WAKE_BIN --version 2>/dev/null || echo '?')"
SERVER_V="$(curl -fsS "$AGENTBUS_URL/version" 2>/dev/null || echo 'unreachable')"

# Real-time wake sidecar. Needs tmux (a pane to poke) + setsid (own session, so it can
# self-reap without touching this shell). $$ is captured BEFORE `exec claude` -- exec keeps
# the pid, so it is Claude's pid; the sidecar watches it and exits when Claude exits. On
# boot the sidecar also pokes the pane once with the usage/CLAUDE.md directive + versions.
sidecar="off (need tmux + setsid)"
if [ -n "${TMUX_PANE:-}" ] && command -v setsid >/dev/null 2>&1; then
    if setsid -f "$REPO/scripts/wake-sidecar" \
        "$TMUX_PANE" "$$" "$WAKE_URL" "$AGENT_ROLE" "$AGENTBUS_TOKEN" "$SERVER_V" "$CLIENT_V" $WAKE_BIN; then
        sidecar="armed (exits with claude)"
    fi
fi

# Liveness / integration status for this agent.
echo "Reveille v$SERVER_V: role=$AGENT_ROLE  broker=$AGENTBUS_URL  client=v$CLIENT_V  sidecar: $sidecar" >&2
if [ "$SERVER_V" != "unreachable" ] && [ "$SERVER_V" != "$CLIENT_V" ]; then
    echo "Reveille: WARNING broker v$SERVER_V != client v$CLIENT_V -- update" >&2
fi

exec claude "$@"
