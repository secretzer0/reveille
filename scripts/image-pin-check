#!/usr/bin/env bash
# Ruling 8433, mechanised (CI ruling 10877 check 2): if a diff touches the
# agent image's build inputs and the tag pin did not move in the same range,
# exit RED. Honour-system since 8433 was made; honour-system is why three
# tags shipped unbuilt and one shipped drifted.
#
# THE PINS ARE A CLOSED, ENUMERATED LIST -- adding a fourth pin is a diff to
# this file, not a discovery. The INPUTS are the docker/ files the agent
# Dockerfile bakes; src/ rides into the agent image via `uv tool install` but
# moves on the VERSION axis, so it is not an AGENT input. It is a SERVER
# input, and the version bump is its pin -- checked below, on the branch.
#
# Usage: image-pin-check <base-ref> <head-ref>   (exit 0 ok, 1 red, 2 usage)
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: image-pin-check <base> <head>" >&2; exit 2; }
base="$1" head="$2"

# ONE DEFINITION OF WHAT AN IMAGE IS MADE OF, read from the publisher that
# also acts on it. Kept as two hand-copied arrays these drifted, silently and
# in the direction that loses: the publisher's agent list was missing
# docker/busdeaf-probe and src/reveille/agent-stop-hook, both of which the
# Dockerfile COPYs, so #275 changed the stop hook's baked verdict text and
# main published nothing -- reveille-agent:0.2.39 went on naming a tree it no
# longer matched, which is ruling 8433 exactly. The range stays ours (see the
# inputs-for hook).
pub="$(dirname "$0")/publish-images"
mapfile -t INPUTS < <("$pub" inputs-for agent)
mapfile -t SERVER_INPUTS < <("$pub" inputs-for server)
PINS=(Makefile scripts/reveille_launch.py tests/test_reveille_launch.py)

# No grep -q under pipefail: -q exits at first match, the producer dies on
# SIGPIPE (141), and pipefail reports the pipeline failed ON a match. Plain
# grep consumes the stream; stdout goes to /dev/null instead.
changed() { git diff --name-only "$base...$head" -- "$@" | grep . >/dev/null; }

# THE TTS IMAGE, same rule, one pin: docker/tts.upstream (the upstream SHA the
# image is built from, DES-009 section 4.1) is its only input and Makefile
# TTS_IMAGE its only pin. Learned the hard way -- its first CI build failed on
# an input change nobody had tagged (run 31915896545), and this check said "no
# agent-image inputs changed" because it only knew one image.
if changed docker/tts.upstream; then
  tts_at() { git show "$1:Makefile" 2>/dev/null | grep -m1 '^TTS_IMAGE ?=' | cut -d= -f2- | tr -d ' '; }
  if [ "$(tts_at "$base")" = "$(tts_at "$head")" ]; then
    echo "image-pin-check: RED -- docker/tts.upstream changed but TTS_IMAGE" >&2
    echo "  did not move ($(tts_at "$head") at both ends). Bump TTS_IMAGE." >&2
    exit 1
  fi
  echo "image-pin-check: tts.upstream changed and TTS_IMAGE moved to $(tts_at "$head")"
fi

# THE SERVER IMAGE, same rule, and its pin is the VERSION: src/, pyproject.toml
# and uv.lock ride into reveille-server, whose tag IS the package version.
#
# This used to be checked on main and nowhere else, deliberately -- branches
# shipped unversioned and the merger numbered at merge, which bought
# collision-avoidance between concurrent PRs. The price was a guaranteed red
# main after every src/ merge, because publish-images must refuse a tag that
# is already written against a tree that no longer matches it. Paid twice in a
# row (#274, #275) before the rule was moved here. Two PRs racing for one
# number is an ordinary merge conflict in pyproject.toml: loud, local, cheap --
# and the number now moves in the same commit as the CHANGES entry that must
# equal it, which is where the writing was happening anyway.
if changed "${SERVER_INPUTS[@]}"; then
  ver_at() { git show "$1:pyproject.toml" 2>/dev/null | grep -m1 '^version' | cut -d'"' -f2; }
  b_ver=$(ver_at "$base"); h_ver=$(ver_at "$head")
  if [ -z "$h_ver" ]; then
    echo "image-pin-check: cannot read the version at $head" >&2; exit 2
  fi
  if [ "$b_ver" = "$h_ver" ]; then
    echo "image-pin-check: RED -- server image inputs changed but the version" >&2
    echo "  did not move ($h_ver at both ends). A tag is written once, so main" >&2
    echo "  would have to refuse a reveille-server:$h_ver that is no longer" >&2
    echo "  what the registry holds under that name. Bump pyproject.toml, run" >&2
    echo "  uv lock, and add the CHANGES_ENTRIES entry that must equal it." >&2
    exit 1
  fi
  echo "image-pin-check: server inputs changed and the version moved to $h_ver"
fi

if ! changed "${INPUTS[@]}"; then
  echo "image-pin-check: no agent-image build inputs changed"
  exit 0
fi

# An input moved: the tag literal must differ between base and head in EVERY
# pin site, or two different images answer to one name.
tag_at() { git show "$1:Makefile" 2>/dev/null | grep -m1 '^AGENT_IMAGE ?=' | cut -d= -f2- | tr -d ' '; }
b_tag=$(tag_at "$base"); h_tag=$(tag_at "$head")
if [ -z "$h_tag" ]; then
  echo "image-pin-check: cannot read AGENT_IMAGE at $head" >&2; exit 2
fi
if [ "$b_tag" = "$h_tag" ]; then
  echo "image-pin-check: RED -- agent-image build inputs changed but the tag" >&2
  echo "  pin did not move ($h_tag at both ends). Two builds of one tag make" >&2
  echo "  launcher.db provision records ambiguous (ruling 8433). Bump" >&2
  echo "  AGENT_IMAGE, DEFAULT_IMAGE and the guarding test pin together." >&2
  exit 1
fi
for f in scripts/reveille_launch.py tests/test_reveille_launch.py; do
  if ! git show "$head:$f" | grep -F "$h_tag" >/dev/null; then
    echo "image-pin-check: RED -- Makefile says $h_tag but $f does not carry" >&2
    echo "  it; the three pins move together or not at all." >&2
    exit 1
  fi
done
echo "image-pin-check: inputs changed and every pin moved to $h_tag"
