#!/usr/bin/env bash
# REFUSES A DEPLOY WHOSE AGENT IMAGE DOES NOT EXIST ON THIS HOST.
#
# DEFAULT_IMAGE names the tag every provision runs. Bumping it is a one-line
# edit; building it is a separate command, and the gap between them is invisible
# to the whole test suite -- unit tests assert the STRING, and a string is
# correct whether or not the tag was ever built. So the failure lands on the
# next human to provision an agent, as a docker pull error for an image that
# only ever existed on a developer's box.
#
# Three times now: 0.2.6, 0.2.7, 0.2.10. Each caught by a reviewer who happened
# to check by hand. A reviewer who happens to look is not a control, so this is
# the control: the deploy asks docker, and docker either has the tag or the
# deploy stops.
#
# Deliberately LOCAL-ONLY (image inspect, never pull): these images are built on
# the host and pushed nowhere, so "docker can find it" and "it exists here" are
# the same question.
set -u

src="$(dirname "$0")/.."
image="${1:-}"
if [ -z "$image" ]; then
  image="$(grep -m1 '^DEFAULT_IMAGE' "$src/scripts/reveille_launch.py" \
           | sed -n 's/.*"\(reveille-agent:[^"]*\)".*/\1/p')"
fi

if [ -z "$image" ]; then
  echo "REFUSING: could not read DEFAULT_IMAGE out of scripts/reveille_launch.py" >&2
  exit 1
fi

# ASK WHETHER THE QUESTION IS ANSWERABLE BEFORE ANSWERING IT.
#
# `docker image inspect` fails identically for "no such tag" and "cannot reach
# the daemon" -- and the second is the common case, because an agent container
# has no docker socket BY DESIGN. Reported as the first, this told a caller the
# image was never built while it sat in the local store, and sent them to
# rebuild something that already existed.
#
# That is the defect this whole slice is about, one level in: a probe whose
# vocabulary cannot express its own inability, reporting a null as a fact.
# Exit 2 means UNKNOWN, and unknown is not the same answer as no.
if ! docker info >/dev/null 2>&1; then
  echo "CANNOT VERIFY the agent image: docker is not reachable from here." >&2
  echo "  wanted: $image" >&2
  echo "This is not a claim that the tag is missing -- it is a claim that this" >&2
  echo "process cannot see the image store at all (no socket, no permission, or" >&2
  echo "no daemon). Run it where docker answers." >&2
  exit 2
fi

if docker image inspect "$image" >/dev/null 2>&1; then
  echo "agent image: $image present"
  exit 0
fi

echo "REFUSING to deploy: the agent image this build provisions does not exist." >&2
echo "  DEFAULT_IMAGE: $image" >&2
echo "  present here:  $(docker images reveille-agent --format '{{.Repository}}:{{.Tag}}' \
                         | tr '\n' ' ')" >&2
echo "Every provision would fail on a tag that was never built. Build it first:" >&2
echo "  make agent-image AGENT_IMAGE=$image" >&2
exit 1
