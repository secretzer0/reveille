#!/usr/bin/env bash
# REFUSES A DEPLOY WHOSE AGENT IMAGE DOES NOT EXIST ON THIS HOST.
#
# DEFAULT_IMAGE names the tag every provision runs. Bumping it is a one-line
# edit; building it is a separate command, and the gap between them is invisible
# to the whole test suite -- unit tests assert the STRING, and a string is
# correct whether or not the tag was ever built. So the failure lands on the
# next human to provision an agent, as a docker pull error for an image that
# only ever existed on a developer's box.
#
# Three times now: 0.2.6, 0.2.7, 0.2.10. Each caught by a reviewer who happened
# to check by hand. A reviewer who happens to look is not a control, so this is
# the control: the deploy asks docker, and docker either has the tag or the
# deploy stops.
#
# ASKS THE REGISTRY, because that premise died. This said "LOCAL-ONLY (image
# inspect, never pull): these images are built on the host and pushed nowhere,
# so 'docker can find it' and 'it exists here' are the same question." CI has
# published every image to ghcr since 10877, and as of the host-pulls cutover
# the deployment RUNS the published one -- so the question that matters is
# whether the registry holds the tag, not whether this box happens to. A local
# hit still answers yes (the pull would be a no-op); a local miss is no longer
# a refusal until the registry has also been asked.
set -u

src="$(dirname "$0")/.."
image="${1:-}"
if [ -z "$image" ]; then
  image="$(grep -m1 -A1 '^DEFAULT_IMAGE' "$src/scripts/reveille_launch.py" \
           | sed -n 's|.*"\([^"]*reveille-agent:[^"]*\)".*|\1|p' | head -1)"
fi

if [ -z "$image" ]; then
  echo "REFUSING: could not read DEFAULT_IMAGE out of scripts/reveille_launch.py" >&2
  exit 1
fi

# ASK WHETHER THE QUESTION IS ANSWERABLE BEFORE ANSWERING IT.
#
# `docker image inspect` fails identically for "no such tag" and "cannot reach
# the daemon" -- and the second is the common case, because an agent container
# has no docker socket BY DESIGN. Reported as the first, this told a caller the
# image was never built while it sat in the local store, and sent them to
# rebuild something that already existed.
#
# That is the defect this whole slice is about, one level in: a probe whose
# vocabulary cannot express its own inability, reporting a null as a fact.
# Exit 2 means UNKNOWN, and unknown is not the same answer as no.
if ! docker info >/dev/null 2>&1; then
  echo "CANNOT VERIFY the agent image: docker is not reachable from here." >&2
  echo "  wanted: $image" >&2
  echo "This is not a claim that the tag is missing -- it is a claim that this" >&2
  echo "process cannot see the image store at all (no socket, no permission, or" >&2
  echo "no daemon). Run it where docker answers." >&2
  exit 2
fi

if docker image inspect "$image" >/dev/null 2>&1; then
  echo "agent image: $image present locally"
  exit 0
fi

# Absent here is not absent: the host pulls, so the registry is the authority.
#
# ONE STATUS IS THE REAL NEGATIVE, everything else is unknown -- the same rule
# one level out from the docker-info check above. `docker manifest inspect`
# fails identically for "no such tag", "not logged in" and "cannot reach the
# registry", and reporting the last two as the first turns a network blip into
# a refused deploy. MEASURED, not assumed: a missing tag on ghcr answers
# `manifest unknown`; an unauthenticated Docker Hub repo answers `denied:
# requested access to the resource is denied`; an unresolvable host answers
# `failed to configure transport`.
if reg_err="$(docker manifest inspect "$image" 2>&1 >/dev/null)"; then
  echo "agent image: $image published (will pull on provision)"
  exit 0
fi
case "$reg_err" in
  *"manifest unknown"*|*"not found"*) ;;          # the registry looked: absent
  *)
    echo "CANNOT VERIFY the agent image: the registry did not answer." >&2
    echo "  wanted: $image" >&2
    echo "  registry said: $reg_err" >&2
    echo "Absent from this host's store is not absent -- the deploy pulls. This" >&2
    echo "is not a claim that the tag is missing, only that nothing here could" >&2
    echo "read the registry that would know." >&2
    exit 2 ;;
esac

echo "REFUSING to deploy: the agent image this build provisions does not exist." >&2
echo "  DEFAULT_IMAGE: $image" >&2
echo "  present here:  $(docker images reveille-agent --format '{{.Repository}}:{{.Tag}}' \
                         | tr '\n' ' ')" >&2
echo "Every provision would fail on a tag that was never built. Build it first:" >&2
echo "  make agent-image AGENT_IMAGE=$image" >&2
exit 1
