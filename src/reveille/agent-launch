#!/usr/bin/env bash
# Launch a Claude Code session bound to a bus identity (Reveille).
#
#   agent roc-api-dev                 # role positional
#   agent --role roc-api-dev          # role flag
#   REVEILLE_AGENT_ROLE=roc-api-dev agent   # role from env
#   agent roc-api-dev --model opus    # extra args after the role go to claude
#
# Config resolves as  CLI flag > environment > default:
#   role  : --role  | $REVEILLE_AGENT_ROLE
#   token : --token | $REVEILLE_TOKEN
#   url   : --url   | $REVEILLE_URL  | http://127.0.0.1:8765
#
# Sets $REVEILLE_AGENT_ROLE (-> the MCP X-Agent header) and $REVEILLE_TOKEN for the session.
# The token is a credential, NOT a room: the broker maps it to the rooms this agent may see,
# so no room name is ever passed here. Wake is
# native: the boot prompt tells the agent to arm `wake-watch <role>` as a background task;
# its completion notification IS the ring -- no keystroke injection, nothing ever types into
# a human's half-written prompt. The Stop hook that blocks ending a turn with the waiter
# unarmed is user-scoped, installed by `make register` (scripts/install-hook).
#
# TMUX IS OPT-IN AND OFF BY DEFAULT (operator directive). Pass --tmux, or set
# REVEILLE_TMUX=1, to get a persistent session. tmux exists in this project for the
# CONTAINER, where ttyd attaches to it -- docker/entrypoint.sh starts its own session
# ("agent") directly and never calls this script, so the native default costs the browser
# plane nothing. Wake has not involved tmux since 0.1.3 removed the keystroke sidecar.
set -euo pipefail

# THE CREDENTIAL FILE IS SOURCED HERE, and this is the line that decides whether
# an installed agent is reachable at all. `reveille init` writes
# ~/.reveille/agent.env (0600) and nothing else reads it: a session started with
# plain `claude` has no $REVEILLE_AGENT_ROLE, the Stop hook fails open and goes
# INERT, no waiter is armed and no watcher exists -- so the agent can SEND
# (the headers are baked into the MCP registration) and can never be WOKEN. It
# answers when someone happens to run a turn and looks quiet forever otherwise,
# which is the silent-deafness failure this fleet has now hit three times
# (architect BLOCKING 2, msg 8966).
#
# The environment WINS over the file: a caller who exported a role meant it.
ENVFILE="${REVEILLE_ENV_FILE:-$HOME/.reveille/agent.env}"
if [ -f "$ENVFILE" ]; then
  while IFS='=' read -r k v; do
    case "$k" in
      REVEILLE_URL|REVEILLE_AGENT_ROLE|REVEILLE_TOKEN)
        # eval-free: a credential file is not a script, and sourcing one would
        # execute whatever a bad umask let somebody append to it.
        [ -z "$(eval "printf '%s' \"\${$k:-}\"")" ] && export "$k=$v" ;;
    esac
  done < "$ENVFILE"
fi

ROLE="${REVEILLE_AGENT_ROLE:-}"
TOKEN="${REVEILLE_TOKEN:-}"
URL="${REVEILLE_URL:-http://127.0.0.1:8765}"

claude_args=()
role_pos=0
# Off unless asked for. --tmux/--no-tmux override the env either way, so a box that
# exports REVEILLE_TMUX=1 can still decline for one launch.
WANT_TMUX="${REVEILLE_TMUX:-}"
while [ $# -gt 0 ]; do
    case "$1" in
        --role)    ROLE="$2"; shift 2 ;;
        --role=*)  ROLE="${1#*=}"; shift ;;
        --token)   TOKEN="$2"; shift 2 ;;
        --token=*) TOKEN="${1#*=}"; shift ;;
        --url)     URL="$2"; shift 2 ;;
        --url=*)   URL="${1#*=}"; shift ;;
        # These MUST be cases here rather than falling through to claude: the -*
        # arm below forwards anything unrecognised, so `--no-tmux` used to land on
        # claude and break the launch with an error naming the wrong program.
        --tmux)    WANT_TMUX=1; shift ;;
        --no-tmux) WANT_TMUX=""; shift ;;
        --)        shift; claude_args+=("$@"); break ;;
        -*)        claude_args+=("$1"); shift ;;
        *)         if [ "$role_pos" -eq 0 ]; then ROLE="$1"; role_pos=1; else claude_args+=("$1"); fi; shift ;;
    esac
done

if [ -z "$ROLE" ]; then
    echo "agent: no role -- pass one (agent <role> | --role X) or set REVEILLE_AGENT_ROLE" >&2
    exit 1
fi

export REVEILLE_AGENT_ROLE="$ROLE"
export REVEILLE_TOKEN="$TOKEN"
export REVEILLE_URL="$URL"

# OPTED IN, and not already inside one: re-launch in a tmux session (persistence/attach).
# This used to fire on `command -v tmux` alone, so every box with tmux installed was
# silently re-execed into a session it never asked for, with no way to decline. Asking for
# tmux where it is not installed now SAYS SO rather than quietly launching without it --
# a request that is silently ignored is the shape that makes people distrust the launcher.
# Re-pass resolved config as flags so a pre-existing tmux server's stale env can't drop it.
if [ -n "$WANT_TMUX" ] && ! command -v tmux >/dev/null 2>&1; then
    echo "agent: --tmux/REVEILLE_TMUX asked for tmux and it is not installed -- "\
"starting without it" >&2
fi
if [ -n "$WANT_TMUX" ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    reinvoke=(--role "$ROLE" --token "$TOKEN" --url "$URL" ${claude_args[@]+"${claude_args[@]}"})
    argq=""; for a in "${reinvoke[@]}"; do argq+=" $(printf '%q' "$a")"; done
    exec tmux new-session -A -s "rev-$ROLE" "exec $(printf '%q' "${BASH_SOURCE[0]}")$argq"
fi

# Resolve symlinks: agent is usually invoked via a ~/.local/bin/agent symlink, so the raw
# BASH_SOURCE would put REPO at ~/.local instead of the actual repo.
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_hostport="${URL#*://}"; _hostport="${_hostport%%/*}"   # strip scheme + any path
_scheme=ws; [ "${URL%%://*}" = "https" ] && _scheme=wss
# THE ARM COMMAND IS wake-watch, NOT wake --once. The old prompt prescribed the
# RETIRED pre-DES-003 ritual: `wake --once` grabs the wake socket ITSELF, and on
# a host where the Stop hook supervises reveille-waked -- every host this
# launcher installs -- the two fight for the one socket: the agent's grab either
# steals the daemon's slot or is superseded into silent deafness. wake-watch
# watches the SPOOL the daemon writes; duplicates are harmless and arming early
# is safe (DES-003). Paid for live: the first native agent's boot banner told it
# to run the retired command, with a site-packages path in it for garnish.
CLIENT_V="$(wake-watch --version 2>/dev/null || wake --version 2>/dev/null || echo '?')"
SERVER_V="$(curl -fsS "$URL/version" 2>/dev/null || echo 'unreachable')"

mm=""
[ "$SERVER_V" != "$CLIENT_V" ] && [ "$SERVER_V" != "unreachable" ] && mm=" (VERSION MISMATCH -- update)"
BOOT="Reveille boot v$SERVER_V$mm. Do now, in order:
1. join(url=\"$URL\") then lessons() and brief(role=\"...\") -- rules the fleet already paid for.
2. Arm your wake waiter -- Bash with run_in_background=true: wake-watch $ROLE
   Its task-completion notification IS a bus ring: inbox(), ack() everything, act only if
   a message names you / blocks you / asks you directly, delete the spool files you
   processed, then RE-ARM the same command.
3. usage() and refresh the '## Agent bus' block in this repo's CLAUDE.md from it.
4. Read LESSONS.md at the repo root, if present. Then wait for work; silence is a valid turn."

# Liveness / integration status for this agent.
echo "Reveille v$SERVER_V: role=$ROLE  broker=$URL  client=v$CLIENT_V  wake=native (arm on boot)" >&2
if [ "$SERVER_V" != "unreachable" ] && [ "$SERVER_V" != "$CLIENT_V" ]; then
    echo "Reveille: WARNING broker v$SERVER_V != client v$CLIENT_V -- update" >&2
fi

exec claude ${claude_args[@]+"${claude_args[@]}"} "$BOOT"
