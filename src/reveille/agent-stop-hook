#!/usr/bin/env bash
# Stop hook (DES-003 2.1/2.2): the host-side supervisor for the split waiter.
#
# Two jobs, opposite lifetimes:
#   reveille-waked  holds THE wake socket and spools rings. Spawned here if
#                   absent; the flock on the agent's spool .lock is the
#                   singleton guard, so a blind spawn is safe -- a loser exits
#                   itself. This hook IS the supervisor (operator ruling: no
#                   systemd); the next firing after a crash respawns it.
#   wake-watch      exit-to-notify, stateless and secretless. If none is
#                   running, block the stop and print the arm line.
#
# Verification is by FLOCK, never presence (a reconnecting daemon reads as
# disconnected mid-retry) and never pgrep of anything carrying a token
# (wake-watch carries none, so matching it by name is safe).
#
# NOTHING HERE PROBES THE BROKER, and that is the load-bearing property (msg
# 8573). Everything this hook does is LOCAL: spawn a daemon that dials the bus
# on its own schedule and retries forever, spawn a local service, and require a
# watcher that reads a local spool directory. None of it needs the bus to be up,
# and all of it is most needed precisely when the bus is down.
#
# This hook used to open with `curl "$url/version" || exit 0` -- fail-open, so a
# broker outage could not block every agent's turn. The intent was right and the
# placement was fatal: it sat ABOVE the supervision blocks, so an unreachable
# broker meant the agent ended its turn WITH NO WATCHER ARMED. The outage
# disabled the recovery mechanism at the moment it was needed: when the bus came
# back, nothing re-armed the watcher, because the only thing that would runs at a
# turn boundary the agent could no longer reach. One agent sat deaf for 21 hours
# with 44 rings in its spool while the bus was healthy again.
#
# So the rule, for anything appended below: WHAT CAN RUN WITHOUT THE REMOTE RUNS
# WITHOUT ASKING ABOUT THE REMOTE. If a future block genuinely needs the broker,
# probe it INSIDE that block and fail open there -- never at the top, where every
# block below inherits a policy nobody chose for it. That inheritance is exactly
# how this happened.
set -u

input="$(cat)"
case "$input" in *'"stop_hook_active":true'* | *'"stop_hook_active": true'*) exit 0 ;; esac

role="${REVEILLE_AGENT_ROLE:-}"
[ -n "$role" ] || exit 0
url="${REVEILLE_URL:-http://127.0.0.1:8765}"

hostport="${url#*://}"; hostport="${hostport%%/*}"
scheme=ws; [ "${url%%://*}" = "https" ] && scheme=wss
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
bindir="$repo/.venv/bin"
spool="${REVEILLE_SPOOL:-$HOME/.reveille/spool}/$role"
mkdir -p "$spool"

# Linux normally supplies `flock`; macOS does not. The hook itself is launched
# by Python, so use that same interpreter for an equivalent non-blocking probe
# when the command is unavailable.
#
# A PROBE THAT CANNOT DECIDE MUST SPAWN (ruling 17377). waked takes this same
# lock at startup and THAT is the singleton guard, so a blind spawn is safe and
# the loser exits 0 -- this probe is an optimisation and never the authority.
# So only a POSITIVE "somebody holds it" answer suppresses the spawn, and each
# branch has exactly one such code: flock's 1, the fallback's 3. Everything
# else -- 127 for no interpreter, a stale REVEILLE_HOOK_PYTHON, an unimportable
# fcntl, a lock file that will not open, flock's own sysexits codes (measured
# on util-linux 2.39.3: 1 conflict, 64 usage, 66 cannot-open) -- means the
# probe did not decide, and reads as FREE. Reading it as "held" is how this
# hook exits 0 with no daemon and no message, which is the very macOS symptom
# the fallback below was added to fix, one layer down.
lock_is_free() {
  lock="$1"
  if command -v flock >/dev/null 2>&1; then
    flock -n "$lock" true
    [ "$?" -ne 1 ]
    return
  fi
  "${REVEILLE_HOOK_PYTHON:-python3}" - "$lock" <<'PY'
import fcntl
import os
import sys

fd = os.open(sys.argv[1], os.O_CREAT | os.O_RDWR, 0o600)
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(3)          # the one positive answer: somebody holds it
finally:
    os.close(fd)
PY
  [ "$?" -ne 3 ]
}

# Daemon alive? flock -n SUCCEEDING means nobody holds it -> daemon absent ->
# spawn one. The daemon takes the same flock at startup, so a race here
# resolves itself (the loser exits 0). Token rides the environment, never argv.
# The URL is handed over unprobed on purpose: waked's own connect loop retries
# forever, so spawning it against a dead broker is how the agent is already
# waiting when the broker returns.
if lock_is_free "$spool/.lock" 2>/dev/null; then
  waked="$bindir/reveille-waked"; [ -x "$waked" ] || waked="reveille-waked"
  nohup "$waked" --url "$scheme://$hostport/wake" --name "$role" \
    >>"$spool/waked.log" 2>&1 &
fi

# The LAUNCHER (DES-006 U2), same supervision, same flock discipline: it is a
# host service, not an agent's, so it is spawned only where an operator has
# declared where its state lives -- ~/.reveille/launcher.env, which must set
# REVEILLE_LAUNCH_DATA, REVEILLE_LAUNCH_DB and REVEILLE_LAUNCH_REPO. No file,
# no spawn: a data root inherited from whoever happened to run a command
# silently moves every agent's home (msg 8499), so the deliberate declaration IS
# the gate. The launcher takes the same lock at startup, so a blind spawn is
# safe; it binds 127.0.0.1 by default and the proxy is the only way in.
#
# REVEILLE_LAUNCH_REPO IS NOT OPTIONAL, and it is deliberately not defaulted to
# $repo -- $repo is a developer's checkout. Spawning from it made `git checkout`
# a deployment: the operator's launcher ran whatever branch someone happened to
# be reviewing, and nobody could answer "what is serving?" without asking a
# person which branch they were on (found by reveille-architect, msg 8568).
# `reveille-launch pin` maintains that path as a clone that only fast-forwards
# main. Undeclared -> no spawn, loudly in the log, because a launcher serving
# unreviewed code is worse than a launcher that is down.
lenv="$HOME/.reveille/launcher.env"
if [ -f "$lenv" ]; then
  # shellcheck disable=SC1090
  ( set -a; . "$lenv"; set +a
    lockdir="$(dirname "${REVEILLE_LAUNCH_DB:-$HOME/.reveille/launcher.db}")"
    mkdir -p "$lockdir"
    if [ -z "${REVEILLE_LAUNCH_REPO:-}" ]; then
      echo "$(date -u +%FT%TZ) launcher NOT started: $lenv declares no" \
           "REVEILLE_LAUNCH_REPO. Run: reveille-launch pin" \
           >>"$lockdir/launcher.log"
    elif lock_is_free "$lockdir/.launcher.lock" 2>/dev/null; then
      py="$REVEILLE_LAUNCH_REPO/.venv/bin/python"; [ -x "$py" ] || py=python3
      nohup "$py" "$REVEILLE_LAUNCH_REPO/scripts/reveille_launch.py" serve \
        --auth-url "$url" >>"$lockdir/launcher.log" 2>&1 &
    fi ) &
fi

# THE DIGEST TRIGGER (DES-001 s16, ruled 23979 s6): a turn ended, so tell the
# broker -- it decides whether a digest is DUE (activity since the last one
# and DIGEST_MIN_INTERVAL elapsed) and writes it from its own script LLM off
# this path. Fire-and-forget: a backgrounded curl with a short timeout, so
# the hook never waits on a model and a down broker costs nothing here. This
# block probes the remote INSIDE itself and fails open, per the rule above.
# It carries the token only as a bearer header on the wire; nothing is logged.
if [ -n "${REVEILLE_TOKEN:-}" ] && command -v curl >/dev/null 2>&1; then
  ( curl -sS -m 5 -X POST -H "authorization: Bearer $REVEILLE_TOKEN" \
      -H "x-agent: $role" "$url/agent/digest" >/dev/null 2>&1 & )
fi

# Watcher armed? wake-watch takes no secret, so a cmdline match is safe. This
# block is the LAST thing and blocks the stop when unarmed -- including while the
# broker is down, because wake-watch reads a local directory and an armed watcher
# is what makes the agent recover by itself when the bus returns.
#
# BOTH SHAPES MATCH, because both are armed: `--follow` runs for the session and
# is the one to prefer, the bare form is one ring and a re-arm. The gate stays a
# PROXY and cannot stop being one: a process exists is not the harness will be
# notified, which is exactly how an architect armed a watcher with `cmd &`,
# satisfied this pgrep with an orphan writing to nothing, and went deaf with
# every control green (2026-08-19). Naming the ARM SHAPE in the block reason is
# the fix that is available here -- and since 2026-09-16 that shape is the
# one-shot under run_in_background, not the Monitor follow: the follow's
# harness timeout costs two blind turns an hour that nothing on our side can
# tune, while the one-shot was MEASURED surviving 11m06s past the 600000 ms cap
# people assumed would kill it. Both shapes still satisfy the pgrep above.
pgrep -f "wake-watch (--follow )?$role( |\$)" >/dev/null 2>&1 && exit 0

# ...OR THE DOORBELL REACHES THIS BODY WITHOUT ONE (0.2.292). Since 0.2.290 a
# ring is not only a file: waked writes the spool entry and then rings the
# session's own inbox socket, which starts a turn in a body sitting idle. A body
# the doorbell can reach needs no watcher, and demanding one anyway is asking
# for a process whose only purpose is to satisfy this line.
#
# THIS IS A BETTER GATE THAN THE pgrep ABOVE, not a hole punched in it. The
# pgrep asks whether a process exists; doorbell.reachable() asks whether a ring
# would ARRIVE -- a waked holding this identity's spool lock, and a live
# interactive session in the identity's own directory with the reveille MCP,
# checked by the same code the delivery uses. The orphaned `cmd &` that went
# deaf with every control green (2026-08-19) passes the pgrep and fails this.
#
# FAILS CLOSED, and that is the whole reason it is safe to put here: any
# refusal, crash, missing interpreter or unimportable module leaves $? non-zero
# and falls through to the block below, which demands the watcher exactly as
# before. Never `|| exit 0`.
if "${REVEILLE_HOOK_PYTHON:-python3}" - "$role" <<'PY' >/dev/null 2>&1
import sys
from reveille import doorbell
ok, _why = doorbell.reachable(sys.argv[1])
sys.exit(0 if ok else 1)
PY
then exit 0; fi

watch_bin="$bindir/wake-watch"; [ -x "$watch_bin" ] || watch_bin="wake-watch"
# The body should learn WHICH half failed rather than arming by reflex, so
# hand it the one command that prints doorbell.reachable()'s own sentence.
# NO DOUBLE QUOTES IN THIS STRING. It is interpolated into a JSON verdict by
# printf, and a stray `\"` makes the whole block unparseable -- which is how
# the unarmed-watcher verdict silently never blocked at all (PR #274). The
# role rides as argv so the python body needs no quoting of its own.
reach_py='import sys; from reveille import doorbell; print(doorbell.reachable(sys.argv[1])[1])'
reach_cmd="${REVEILLE_HOOK_PYTHON:-python3} -c '$reach_py' $role"
printf '{"decision":"block","reason":"THE DOORBELL CANNOT REACH YOU and no watcher is armed, so you are deaf to bus rings. The arm rule is dead: a reachable body needs no watcher, and this block means reachability FAILED -- not that you should arm by habit. FIX REACHABILITY FIRST. Run: %s -- it names the half that failed (no waked holding your spool lock, the directory claiming another identity, no reveille MCP, or no live interactive session in your registered directory). If you cannot fix it here, arm ONCE as the fallback with Bash run_in_background=true: %s %s -- bare, nothing prepended or appended -- then inbox(), ack(), act only if owed, and `reveille ack <the spool path the ring names, under %s/new/>` to ack and rm in one call. Arm ONCE and VERIFY on the next turn: a second arm while the first still holds the socket SIGTERMs the newcomer (exit 143) and leaves you unarmed behind an exit code that reads as ordinary noise."}\n' "$reach_cmd" "$watch_bin" "$role" "$spool"
exit 0
