#!/usr/bin/env bash
# attach-gate: the ONLY door between ttyd and the agent's tmux (DES-002 4.3).
#
# ttyd never execs tmux directly; it execs `attach-gate attach` with the URL's
# ?arg= values appended. The FIXED literal "attach" is load-bearing: ttyd's -a
# hands the client control of argv, so without it a browser could invoke `mint`
# and mint itself a driver grant -- the subcommands below are trusted-side only
# (docker exec / launcher), and the ONLY dispatch reachable from the wire is
# `attach <token>`. The token is verified OFFLINE against the per-container
# secret (R3, ratified): no polling, no gate-to-launcher channel. Revocation is
# the launcher docker-exec'ing a kill of this process group -- nothing in here
# watches anything.
#
#   attach-gate attach <token>             verify, then exec tmux into the
#                                          per-grant grouped session (4.6):
#                                          v-<id> read-only, d-<id> writable
#   attach-gate verify <token>             verify only, print "ok <mode> <id>"
#   attach-gate mint <viewer|driver> [ttl_seconds] [grant_id]
#                                          print a signed token (launcher UI's
#                                          job in T3; by hand until then)
#
# Token: v1.<grant-id>.<mode>.<exp-epoch>.<hmac-sha256-hex>
# Secret: $REVEILLE_GATE_SECRET, injected at provision. Both planes of a grant
# (mint and verify) see the same secret; nobody else can forge a signature.
set -euo pipefail

die() { echo "attach-gate: $*" >&2; exit 1; }

# Env when the launcher (or a test) injects it; otherwise the file the
# entrypoint persisted -- the only way `docker exec` invocations can sign.
if [ -z "${REVEILLE_GATE_SECRET:-}" ] && [ -r "${HOME:-}/.gate-secret" ]; then
  REVEILLE_GATE_SECRET="$(cat "${HOME}/.gate-secret")"
fi
[ -n "${REVEILLE_GATE_SECRET:-}" ] || die "REVEILLE_GATE_SECRET not set"

hmac() { printf '%s' "$1" | openssl dgst -sha256 -hmac "$REVEILLE_GATE_SECRET" | awk '{print $NF}'; }

mint() {
  local mode="${1:?mint needs a mode: viewer|driver}"
  case "$mode" in viewer|driver) ;; *) die "mode must be viewer or driver" ;; esac
  local ttl="${2:-86400}"   # Q2: 24h default, renew by re-minting
  local id="${3:-$(openssl rand -hex 4)}"
  local payload="v1.${id}.${mode}.$(( $(date +%s) + ttl ))"
  echo "${payload}.$(hmac "$payload")"
}

# Returns "<mode> <id>" on stdout iff the token is genuine and unexpired.
check() {
  local token="${1:?no token}" v id mode exp sig
  IFS=. read -r v id mode exp sig <<<"$token"
  [ "$v" = v1 ] && [ -n "${sig:-}" ] || die "malformed token"
  local want; want="$(hmac "v1.${id}.${mode}.${exp}")"
  # Compare via fresh-keyed HMACs so the string compare's timing says nothing
  # about how many leading bytes of the real signature the caller guessed.
  local k; k="$(openssl rand -hex 16)"
  [ "$(printf '%s' "$sig"  | openssl dgst -sha256 -hmac "$k" | awk '{print $NF}')" \
  = "$(printf '%s' "$want" | openssl dgst -sha256 -hmac "$k" | awk '{print $NF}')" ] \
    || die "bad signature"
  [ "$(date +%s)" -lt "$exp" ] || die "token expired"
  case "$mode" in viewer|driver) ;; *) die "unknown mode" ;; esac
  echo "$mode $id"
}

# 4.5.2: ATTACH is the gate's audit line -- it alone holds the verified grant id
# and mode before the exec erases it. The launcher harvests this file on its
# sweep tick into the host-side audit log; detach/revoke lines are the
# launcher's, derived there, never fabricated here.
audit_attach() {
  printf '%s ATTACH %s %s\n' "$(date -u +%FT%TZ)" "$1" "$2" \
    >>"${REVEILLE_AUDIT_LOG:-${HOME:-/tmp}/.attach-audit}" 2>/dev/null || true
}

# Multi-driver opt-out (4.3): create-time env, or the runtime marker the
# launcher's `flip` command touches -- exec'd ttyd children only ever see
# create-time env, so a post-provision toggle needs a file.
multi_driver() {
  [ "${REVEILLE_MULTI_DRIVER:-0}" = 1 ] || [ -e "${HOME:-}/.multi-driver" ]
}

attach() {
  # check runs in a command substitution, where its die() only kills the
  # subshell -- the assignment carries the failure out so set -e can act on it.
  local res mode id
  res="$(check "$1")"
  read -r mode id <<<"$res"
  if [ "$mode" = viewer ]; then
    # Grouped session (shares the agent's windows, independent focus), attached
    # read-only: tmux drops every keystroke server-side -- the browser cannot
    # opt out of -r because -r never crossed the wire. destroy-unattached reaps
    # the visitor session on detach; it MUST be set after the attach in one
    # command sequence -- set on a still-detached session, tmux reaps it on the
    # spot and the attach finds nothing.
    audit_attach viewer "$id"
    tmux new-session -d -t agent -s "v-${id}" 2>/dev/null || true
    exec tmux -u attach-session -r -t "v-${id}" \; set-option destroy-unattached on
  fi
  # Driver (4.6): a per-grant WRITABLE grouped session -- the revocable handle.
  # T1's `exec tmux attach -t agent` left revocation nothing to aim at; d-<id>
  # makes revoke `tmux kill-session -t d-<id>`, and the owner's ssh attach to
  # session "agent" sits outside every d-*/v-* handle, so revoking a grantee
  # can never boot the owner.
  # Exclusivity (4.3): another grant's d-* session existing IS the refusal --
  # readable, naming the holder. The same grant re-attaching to its own d-<id>
  # is a reconnect, not a second driver. An owner attached over ssh is outside
  # this bookkeeping (sanctioned, 4.5).
  if ! multi_driver; then
    local holder
    holder="$(tmux list-sessions -F '#{session_name}' 2>/dev/null \
                | grep '^d-' | grep -vx "d-${id}" | head -n1 || true)"
    [ -z "$holder" ] || die \
      "driver attach refused: grant ${holder#d-} holds the keyboard (owner: reveille-launch flip <user> <agent> on)"
  fi
  tmux new-session -d -t agent -s "d-${id}" 2>/dev/null || true
  # 4.6.1: the pre-check alone is check-then-create -- two racing writable
  # attaches both see an empty list, both create, and the sweep kills neither
  # (both grants healthy, both sessions mode-matched). So re-check AFTER
  # creating: if another d-* precedes ours (creation time, tie broken by name),
  # we lost the race -- kill our own session and refuse naming the survivor.
  # Both racers run this same rule, so exactly one persists.
  if ! multi_driver; then
    local own rival rc rn
    own="$(tmux display-message -p -t "d-${id}" '#{session_created}')"
    rival="$(tmux list-sessions -F '#{session_created} #{session_name}' 2>/dev/null \
               | grep ' d-' | grep -v " d-${id}\$" | sort -n | head -n1 || true)"
    if [ -n "$rival" ]; then
      read -r rc rn <<<"$rival"
      if [ "$rc" -lt "$own" ] || { [ "$rc" -eq "$own" ] && [[ "$rn" < "d-${id}" ]]; }; then
        tmux kill-session -t "d-${id}" 2>/dev/null || true
        die "driver attach refused: grant ${rn#d-} holds the keyboard (owner: reveille-launch flip <user> <agent> on)"
      fi
    fi
  fi
  audit_attach driver "$id"
  exec tmux -u attach-session -t "d-${id}" \; set-option destroy-unattached on
}

# No catch-all-as-token: an unknown first arg dies. Anything a browser smuggles
# past the fixed "attach" arrives at attach() as a token and fails the HMAC.
case "${1:-}" in
  mint)   shift; mint "$@" ;;
  verify) shift; res="$(check "${1:?verify needs a token}")"; echo "ok $res" ;;
  attach) shift; attach "${1:?attach needs a token}" ;;
  "")     die "usage: attach-gate attach <token> | verify <token> | mint <mode> [ttl] [id]" ;;
  *)      die "unknown subcommand: $1" ;;
esac
